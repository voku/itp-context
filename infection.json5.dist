{
  "$schema": "https://infection.github.io/schema.json",
  "source": {
    "directories": [
      "src"
    ]
  },
  "logs": {
    "github": true,
    "text": "infection.log"
  },
  "tmpDir": ".infection",
  "threads": "max",
  "phpUnit": {
    "configDir": ".",
    "customPath": "vendor/bin/phpunit"
  },
  "phpStan": {
    "configDir": ".",
    "customPath": "vendor/bin/phpstan"
  },
  "staticAnalysisTool": "phpstan",
  "staticAnalysisToolOptions": "--memory-limit=1G",
  "testFrameworkOptions": "--colors=never"
}
